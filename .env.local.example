# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.

# ── Database (Supabase) ──────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-side only, never exposed to client

# ── LinkedIn profile provider (Bright Data) ──────────────────────
# Primary source for LinkedIn profile data. LinkedIn is routed here directly;
# it is never sent to Firecrawl. Without this token the app falls back to
# public-web research and reports the limitation in the UI.
BRIGHTDATA_API_TOKEN=
# Optional. Defaults to the LinkedIn people-profiles dataset gd_l1viktl72bvl7bjuj0.
BRIGHTDATA_LINKEDIN_DATASET_ID=
BRIGHTDATA_TIMEOUT_MS=

# ── Reasoning (Google Gemini, Interactions API) ──────────────────
# NOTE: current models are served by POST /v1/interactions, not :generateContent.
GEMINI_API_KEY=
# Model is configuration, never hardcoded in application logic.
GEMINI_MODEL=                        # defaults to gemini-3.7-flash
# Tried automatically when the primary is quota-exhausted or unavailable.
# Verify it is actually reachable for your key before setting it.
GEMINI_FALLBACK_MODEL=

# ── Search / scrape ──────────────────────────────────────────────
TAVILY_API_KEY=                      # primary search provider
BRAVE_SEARCH_API_KEY=                # optional second provider
FIRECRAWL_API_KEY=                   # page fetching for NON-LinkedIn sources

# ── Outreach sender identity (used when drafting) ────────────────
SENDER_NAME=                         # signs the drafted message
SENDER_COMPANY=
SENDER_VALUE_PROP=                   # one line: what you sell

# What qualification is allowed to match a company against. JSON array of
# { id, name, description, applies_when }. `applies_when` describes the
# observable characteristics that make a capability plausibly relevant.
#
# Keep this here rather than in code: your capability list and fit criteria are
# commercial information, and .env.local is gitignored.
SENDER_CAPABILITIES=

# The approved solution catalog outreach may recommend and reference by name.
# JSON array of { id, name, description, supported_workflows, target_functions,
# use_cases, non_use_cases, matches_capability_ids }. `matches_capability_ids`
# lists which SENDER_CAPABILITIES id(s) (above) this solution addresses —
# matching is done deterministically in code (lib/solutions/match.ts), never
# by the model. A solution catalog and your capability list are commercial
# information; keep both here, never in the repository.
ZAMP_SOLUTION_CATALOG=

# ── Orchestration ────────────────────────────────────────────────
USE_INNGEST=false
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── Public endpoint protection ───────────────────────────────────
# If set, POST /api/runs requires header `x-run-secret` or `?secret=`.
RUN_SHARED_SECRET=
RUN_RATE_LIMIT_PER_HOUR=
